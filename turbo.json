{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", "build/**"]
        },
        "test": {
            "dependsOn": ["^build"],
            "outputs": ["coverage/**"],
            "inputs": ["$TURBO_DEFAULT$", ".env*", "!coverage/**"]
        },
        "lint": {},
        "typecheck": {
            "dependsOn": ["^build"],
            "outputs": ["*.tsbuildinfo", "**/*.tsbuildinfo"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
