# ---- payroll-adapter environment ----
PORT=3012
NODE_ENV=development

DATABASE_URL=postgres://postgres:dev@localhost:55433/strafor_payroll

# Shared secret other services present via X-Service-Token (>= 8 chars).
SERVICE_AUTH_TOKEN=CHANGE_ME

# Domain events (optional — publishing is skipped when unset/unreachable)
RABBITMQ_URL=amqp://dev:dev@localhost:55672
RABBITMQ_EXCHANGE=domain.events

# file_generic adapter drop dir — provider result files land here
# (period-<id>.json or period-<id>.csv unless provider config overrides `file`).
IMPORTS_DIR=./payroll_imports
# Generated export files (provider_import / bank_disperse CSVs).
EXPORTS_DIR=./payroll_exports
