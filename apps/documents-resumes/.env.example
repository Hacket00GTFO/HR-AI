# ---- documents-resumes environment ----
PORT=3004
NODE_ENV=development

DATABASE_URL=postgres://postgres:dev@localhost:55433/strafor_documents

# MinIO / S3-compatible object store (forcePathStyle is always on)
MINIO_ENDPOINT=localhost
MINIO_PORT=59000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=dev
MINIO_SECRET_KEY=devdevdev
MINIO_BUCKET=strafor-documents
MINIO_AUTOCREATE=true
# Set when presigned URLs must use a browser-reachable host instead of MINIO_ENDPOINT
# MINIO_PUBLIC_ENDPOINT=http://localhost:59000

# Domain events (optional — publishing is skipped when unset/unreachable)
RABBITMQ_URL=amqp://dev:dev@localhost:55672
RABBITMQ_EXCHANGE=domain.events

MAX_UPLOAD_BYTES=10485760
PRESIGN_EXPIRES_SECONDS=900
PARSE_VERSION=1
WORKER_POLL_MS=1500
JOB_MAX_ATTEMPTS=5

# Legacy import script
# LEGACY_RESUMES_DIR=../../secure_uploads/resumes
# IMPORT_MAP_OUT=../../infra/seed-data/legacy-resume-map.json
