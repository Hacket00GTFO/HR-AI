{
    "name": "@strafor/calendar-bridge",
    "version": "0.1.0",
    "private": true,
    "description": "StraforAI calendar-bridge: Microsoft 365 / Exchange calendar wrapper for interview scheduling, with a deterministic stub provider when no M365 credentials exist",
    "files": [
        "dist",
        "migrations",
        "scripts"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "dev": "tsc -p tsconfig.json && node --watch dist/server.js",
        "migrate": "node scripts/migrate.js up",
        "migrate:down": "node scripts/migrate.js down",
        "migrate:create": "node-pg-migrate create",
        "test": "vitest run",
        "lint": "eslint .",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@strafor/node-common": "workspace:*",
        "amqplib": "^0.10.9",
        "dotenv": "^16.5.0",
        "express": "^4.18.2",
        "node-pg-migrate": "^9.0.0",
        "pg": "^8.23.0",
        "zod": "^4.6.2"
    },
    "devDependencies": {
        "@strafor/eslint-config": "workspace:*",
        "@strafor/tsconfig": "workspace:*",
        "@types/amqplib": "^0.10.5",
        "@types/express": "^4.17.21",
        "@types/node": "^24.0.0",
        "@types/pg": "^8.15.0",
        "@types/supertest": "^6.0.3",
        "eslint": "^9.0.0",
        "supertest": "^7.2.2",
        "typescript": "^5.9.0",
        "vitest": "^5.0.0",
        "typescript-eslint": "^8.0.0"
    }
}
