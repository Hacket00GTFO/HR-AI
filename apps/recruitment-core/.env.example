# ---- recruitment-core environment ----
PORT=3009
NODE_ENV=development

# Own database — created by infra/compose/initdb/01-create-service-dbs.sql
# on first postgres init; on existing pgdata volumes run manually:
#   psql -U <user> -c "CREATE DATABASE strafor_recruitment;"
DATABASE_URL=postgres://postgres:dev@localhost:55433/strafor_recruitment

# Downstream services
AI_SERVICE_URL=http://localhost:3005
AI_MIN_MATCH_SCORE=0.35
DOCUMENTS_URL=http://localhost:3004

# Shared secret presented as X-Service-Token on service-to-service calls and
# accepted from trusted callers (ai-matching, future projections).
SERVICE_AUTH_TOKEN=dev-service-token-change-me

# Synthetic staff identity presented to documents-resumes for anonymous
# public-apply resume uploads (documents-resumes only checks header presence).
SERVICE_CALLER_USER_ID=1

# Legacy fallback only: when set AND a candidate has a legacy `resume`
# filename (no resume_document_id), GET /v1/candidates/:id/resume serves the
# file straight from this directory.
# RESUMES_DIR=../../secure_uploads/resumes

# Domain events (optional — publishing is skipped when unset/unreachable;
# the outbox_events table keeps them for the sweeper to retry)
RABBITMQ_URL=amqp://dev:dev@localhost:55672
RABBITMQ_EXCHANGE=domain.events
OUTBOX_POLL_MS=15000

# Uploads (must not exceed the documents-resumes limit)
MAX_UPLOAD_BYTES=5242880

# Anonymous apply rate limit
PUBLIC_APPLY_RATE_MAX=20
PUBLIC_APPLY_RATE_WINDOW_MS=3600000
