# ---- analytics environment ----
PORT=3008
NODE_ENV=development

DATABASE_URL=postgres://postgres:dev@localhost:55433/strafor_analytics

# Shared secret other services present via X-Service-Token (min 8 chars)
SERVICE_AUTH_TOKEN=dev-service-token-change-me

# Domain events (optional — consumer retries in background when absent)
RABBITMQ_URL=amqp://dev:dev@localhost:55672
RABBITMQ_EXCHANGE=domain.events
