# ---- time-attendance environment ----
PORT=3011
NODE_ENV=development

DATABASE_URL=postgres://postgres:dev@localhost:55433/strafor_time

# Shared secret other services present via X-Service-Token (min 8 chars).
# Guards POST /v1/leave/accrue (internal entitlement recomputation).
SERVICE_AUTH_TOKEN=dev-service-token-change-me

# Domain events (optional — publishing is skipped when unset/unreachable)
RABBITMQ_URL=amqp://dev:dev@localhost:55672
RABBITMQ_EXCHANGE=domain.events

# Pool tuning (optional)
# PG_POOL_MAX=10
# PG_IDLE_TIMEOUT_MS=30000
# PG_CONN_TIMEOUT_MS=5000
