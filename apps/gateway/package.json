{
    "name": "@strafor/gateway",
    "version": "0.1.0",
    "private": true,
    "description": "StraforAI API gateway: thin reverse proxy, RS256 JWT enforcement via JWKS, Redis token blacklist, correlation-id propagation",
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "lint": "eslint ."
    },
    "dependencies": {
        "@strafor/node-common": "workspace:*",
        "cors": "^2.8.5",
        "dotenv": "^16.5.0",
        "express": "^4.18.2",
        "express-rate-limit": "^8.7.0",
        "helmet": "^8.3.0",
        "http-proxy-middleware": "^3.0.0",
        "ioredis": "^5.4.0",
        "jsonwebtoken": "^9.0.2",
        "jwks-rsa": "^3.1.0"
    },
    "devDependencies": {
        "@strafor/eslint-config": "workspace:*",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/node": "^22.0.0",
        "@types/supertest": "^6.0.2",
        "eslint": "^9.0.0",
        "jose": "^5.9.6",
        "supertest": "^7.2.2",
        "typescript": "^5.6.0",
        "typescript-eslint": "^8.0.0",
        "vitest": "^5.0.0"
    }
}
