# ---- gateway environment ----
PORT=8080
NODE_ENV=development
SERVICE_NAME=gateway
LOG_LEVEL=

# Upstream service URLs (container-to-container names for compose;
# localhost for bare-metal dev). V1 services get the /api prefix stripped
# (gateway /api/v1/x → upstream /v1/x). Legacy /api/* and non-/api paths go
# to API_URL unchanged.
API_URL=http://localhost:3000              # monolith (fallback for everything)
IDENTITY_URL=http://localhost:3001         # required — also serves JWKS
VACANCIES_URL=                             # unset → API_URL
CANDIDATES_URL=                            # unset → API_URL
DOCUMENTS_URL=                             # unset → API_URL
NOTIFICATIONS_URL=                         # unset → API_URL
AI_SERVICE_URL=                            # unset → API_URL
STATIC_FALLBACK_URL=                       # non-/api paths → defaults to API_URL

# JWKS endpoint used to verify RS256 access tokens (defaults to
# ${IDENTITY_URL}/.well-known/jwks.json).
IDENTITY_JWKS_URL=
JWT_ISSUER=strafor-identity

# Redis — token blacklist (bl:<jti>) + distributed rate limiting.
# Unset → in-memory rate limiter, blacklist checks skipped (fail-open).
REDIS_URL=redis://localhost:6379

# CORS allowlist (comma-separated).
CORS_ORIGIN=http://localhost:3000

# Proxy timeouts (ms). Uploads get UPLOAD_TIMEOUT_MS.
PROXY_TIMEOUT_MS=10000
UPLOAD_TIMEOUT_MS=30000
