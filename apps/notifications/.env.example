# ---- notifications environment ----
PORT=3007
NODE_ENV=development

DATABASE_URL=postgres://postgres:dev@localhost:55433/strafor_notifications

# SMTP — Mailpit dev sink (no auth)
SMTP_HOST=localhost
SMTP_PORT=51025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=StraforAI <no-reply@strafor.local>

# Shared secret other services present via X-Service-Token (min 8 chars)
SERVICE_AUTH_TOKEN=dev-service-token-change-me

# Domain events (optional — consumer retries in background when absent)
RABBITMQ_URL=amqp://dev:dev@localhost:55672
RABBITMQ_EXCHANGE=domain.events

WORKER_POLL_MS=1500
RETRY_BASE_MS=5000
MAX_ATTEMPTS=5
