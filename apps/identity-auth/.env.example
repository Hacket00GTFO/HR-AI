# ---- identity-auth environment ----
# Copy to .env and fill in real values. NEVER commit a real .env.

# Service
PORT=3001
NODE_ENV=development
SERVICE_NAME=identity-auth
LOG_LEVEL=

# Own database (required — no fallback).
DATABASE_URL=postgres://strafor:CHANGE_ME@localhost:5432/strafor_identity

# Redis — token blacklist (bl:<jti>) + rate-limit backing. Optional but
# strongly recommended; without it revocation falls back to users.logged_out.
REDIS_URL=redis://localhost:6379

# ---- JWT (RS256) ----
# Either provide the PEMs inline (escape newlines as \n) or as files.
# Generate a pair:  pnpm --filter @strafor/identity-auth genkeys
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Or point at PEM files (default lookup: ./keys/private.pem + ./keys/public.pem)
JWT_PRIVATE_KEY_FILE=
JWT_PUBLIC_KEY_FILE=
# Dev/CI escape hatch: generate an ephemeral in-memory keypair at boot.
# NEVER enable in production — tokens die with the process.
JWT_GENERATE_KEYS=false

# Token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# AES-256-GCM key (base64, 32 bytes) for encrypting settings secrets at rest.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required only for /v1/settings/integrations writes; boot warns if missing.
SETTINGS_ENCRYPTION_KEY=

# Optional integrations — service degrades gracefully when unset.
RABBITMQ_URL=            # publishes domain events (quorum queue domain.events)
NOTIFICATIONS_URL=       # e.g. http://localhost:3007 — used for password-reset mails
PUBLIC_BASE_URL=http://localhost:8080   # base for reset links
SOURCE_DATABASE_URL=     # monolith DB — only used by scripts/import-legacy.js

# Pool tuning (optional)
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONN_TIMEOUT_MS=5000
PGSSLMODE=
