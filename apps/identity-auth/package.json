{
    "name": "@strafor/identity-auth",
    "version": "0.1.0",
    "private": true,
    "description": "StraforAI identity & auth microservice: RS256 access tokens, rotating refresh tokens, users, settings, audit",
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "lint": "eslint .",
        "migrate": "node scripts/migrate.js up",
        "migrate:down": "node scripts/migrate.js down",
        "migrate:create": "node-pg-migrate create --migrations-dir migrations",
        "genkeys": "node scripts/genkeys.js",
        "import-legacy": "node scripts/import-legacy.js"
    },
    "dependencies": {
        "@strafor/node-common": "workspace:*",
        "amqplib": "^0.10.4",
        "bcryptjs": "^2.4.3",
        "dotenv": "^16.5.0",
        "express": "^4.18.2",
        "express-rate-limit": "^8.7.0",
        "helmet": "^8.3.0",
        "ioredis": "^5.4.0",
        "jose": "^5.9.6",
        "node-pg-migrate": "^9.0.0",
        "pg": "^8.23.0",
        "zod": "^4.6.2"
    },
    "devDependencies": {
        "@strafor/eslint-config": "workspace:*",
        "@types/amqplib": "^0.10.5",
        "@types/express": "^4.17.21",
        "@types/node": "^22.0.0",
        "@types/pg": "^8.11.0",
        "@types/supertest": "^6.0.2",
        "eslint": "^9.0.0",
        "supertest": "^7.2.2",
        "typescript": "^5.6.0",
        "vitest": "^5.0.0"
    }
}
