{
    "name": "@strafor/api",
    "version": "1.0.0",
    "private": true,
    "description": "StraforAI Express monolith: HR portal REST API + static UI",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "node --watch server.js",
        "test": "vitest run",
        "lint": "eslint .",
        "migrate": "node scripts/migrate.js up",
        "migrate:down": "node scripts/migrate.js down",
        "migrate:create": "node-pg-migrate create",
        "migrate:stamp-baseline": "node scripts/stamp-baseline.js",
        "seed": "node scripts/seed.js",
        "create-admin": "node scripts/createAdmin.js"
    },
    "dependencies": {
        "@strafor/contracts": "workspace:*",
        "@strafor/node-common": "workspace:*",
        "amqplib": "^0.10.9",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.5.0",
        "express": "^4.18.2",
        "express-rate-limit": "^8.7.0",
        "helmet": "^8.3.0",
        "ioredis": "^5.4.0",
        "jsonwebtoken": "^9.0.2",
        "jwks-rsa": "^3.1.0",
        "multer": "^1.4.5-lts.1",
        "node-pg-migrate": "^9.0.0",
        "pdfkit": "^0.13.0",
        "pg": "^8.23.0",
        "zod": "^4.6.2"
    },
    "devDependencies": {
        "@faker-js/faker": "^10.6.0",
        "@strafor/eslint-config": "workspace:*",
        "eslint": "^9.0.0",
        "supertest": "^7.2.2",
        "vitest": "^5.0.0"
    }
}
