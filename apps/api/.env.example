# ---- StraforAI environment variables ----
# Copy to .env and fill in real values. NEVER commit a real .env.

# PostgreSQL connection string used by the app (required — no fallback).
DATABASE_URL=postgres://strafor:CHANGE_ME@localhost:5432/innovation

# Credentials for the postgres container in docker-compose.yml (required there).
POSTGRES_DB=innovation
POSTGRES_USER=strafor
POSTGRES_PASSWORD=CHANGE_ME

# Legacy HS256 signing secret — only required when ALLOW_LEGACY_HS256=true.
# New RS256 tokens are issued by identity-auth and verified via JWKS.
# Generate a long random value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME

# Access-token lifetime. Short-lived by design (default 15m).
JWT_EXPIRES_IN=15m

# Comma-separated allowlist of origins permitted to call the API with
# credentials. Unset in development → only http://localhost:3000 is allowed.
# Example: CORS_ORIGIN=https://strafor.example.com,https://admin.strafor.example.com
CORS_ORIGIN=

# Port the HTTP server binds to (default 3000).
PORT=3000

# Connection pool tuning (all optional).
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONN_TIMEOUT_MS=5000
# TLS for the pool: disable | require (a.k.a. no-verify) | verify-full.
# Leave unset for plain local Postgres. DATABASE_SSL=true is also accepted.
PGSSLMODE=

# Database is versioned with node-pg-migrate (apps/api/migrations/).
#   pnpm --filter @strafor/api migrate        # apply pending migrations
#   pnpm --filter @strafor/api migrate:down   # roll back the last one
# On a database created by the OLD schema.sql bootstrap, stamp the baseline
# first:  pnpm --filter @strafor/api migrate:stamp-baseline
# Demo data:  pnpm --filter @strafor/api seed

# Initial admin bootstrap (scripts/createAdmin.js) — required when running it.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# ---- Identity service (auth extracted to apps/identity-auth) ----
# Base URL of the identity service — auth/user/settings routes proxy to it.
IDENTITY_URL=http://localhost:3001
# JWKS endpoint used to verify RS256 access tokens issued by identity-auth.
IDENTITY_JWKS_URL=http://localhost:3001/.well-known/jwks.json
# Issuer expected on RS256 access tokens.
JWT_ISSUER=strafor-identity
# Redis — token blacklist (bl:<jti>) checked on every authenticated request.
# Unset → revocation falls back to the local users.logged_out flag.
REDIS_URL=redis://localhost:6379
# Temporary escape hatch: also accept legacy HS256 tokens signed with
# JWT_SECRET while sessions roll over to RS256. Default false.
ALLOW_LEGACY_HS256=false
