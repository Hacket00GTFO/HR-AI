# ---- @strafor/web environment ----
# Copy to apps/web/.env.local and fill in real values. NEVER commit a real .env.

# Backend the BFF route handlers proxy to in AUTH_MODE=legacy (the Express
# monolith). Server-side only — never exposed to the browser.
API_URL=http://localhost:3000

# API gateway base URL — used once AUTH_MODE=v1 (strangler migration target).
# GATEWAY_URL=http://localhost:8080

# Which backend contract the BFF targets:
#   legacy → POST {API_URL}/api/auth/login → { token, user }
#   v1     → POST {GATEWAY_URL}/api/v1/auth/login → { accessToken, refreshToken, user }
AUTH_MODE=legacy

# Port `next dev`/`next start` binds to (compose assigns 3010).
PORT=3010
