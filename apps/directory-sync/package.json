{
    "name": "@strafor/directory-sync",
    "version": "0.1.0",
    "private": true,
    "description": "StraforAI directory-sync worker: keeps cross-service users/employee projections populated",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "dev": "tsc -p tsconfig.json && node --watch dist/server.js",
        "test": "vitest run",
        "lint": "eslint .",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@strafor/node-common": "workspace:*",
        "dotenv": "^16.5.0",
        "express": "^4.18.2",
        "pg": "^8.23.0",
        "zod": "^4.6.2"
    },
    "devDependencies": {
        "@strafor/eslint-config": "workspace:*",
        "@strafor/tsconfig": "workspace:*",
        "@types/express": "^4.17.21",
        "@types/node": "^24.0.0",
        "@types/pg": "^8.15.0",
        "@types/supertest": "^6.0.3",
        "eslint": "^9.0.0",
        "supertest": "^7.2.2",
        "typescript": "^5.9.0",
        "vitest": "^5.0.0",
        "typescript-eslint": "^8.0.0"
    }
}
