# ---- hr-services environment ----
PORT=3014
NODE_ENV=development

DATABASE_URL=postgres://postgres:dev@localhost:55433/strafor_services

# Shared secret other services present via X-Service-Token (>= 8 chars).
SERVICE_AUTH_TOKEN=CHANGE_ME

# HMAC key for survey respondent pseudonymisation (>= 16 chars).
# Optional — when unset it is derived from SERVICE_AUTH_TOKEN. Set a real
# secret in any shared environment so a leaked service token cannot be used
# to re-identify survey respondents.
SURVEY_RESPONDENT_SALT=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Minimum respondents per aggregation group before survey results are shown
# (k-anonymity threshold). Groups below it are returned as suppressed.
SURVEY_MIN_GROUP_SIZE=5

# Ticket SLA defaults, in hours, by priority.
SLA_CRITICAL_HOURS=4
SLA_HIGH_HOURS=24
SLA_NORMAL_HOURS=72
SLA_LOW_HOURS=168

# Domain events (optional — events accumulate in outbox_events until a
# broker is configured).
RABBITMQ_URL=amqp://dev:dev@localhost:55672
RABBITMQ_EXCHANGE=domain.events
OUTBOX_POLL_MS=15000
