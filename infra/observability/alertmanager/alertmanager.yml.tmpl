global:
  resolve_timeout: 5m
  smtp_smarthost: '${ALERT_SMTP_HOST}:${ALERT_SMTP_PORT}'
  smtp_from: '${ALERT_SMTP_FROM}'
  smtp_require_tls: false

templates:
  - '/etc/alertmanager/templates/*.tmpl'

route:
  group_by: ['alertname', 'service']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: 'default'
  routes:
    # Critical alerts go to both email and webhook immediately
    - matchers: ['severity="critical"']
      receiver: 'all'
      group_wait: 10s
      repeat_interval: 1h
    # Warning alerts go to both, less frequently
    - matchers: ['severity="warning"']
      receiver: 'all'
      repeat_interval: 4h
    # Info alerts only go to webhook (no email noise)
    - matchers: ['severity="info"']
      receiver: 'strafor-admin'

receivers:
  - name: 'default'
    email_configs:
      - to: '${ALERT_EMAIL_TO}'
    webhook_configs:
      - url: 'http://api:3000/api/admin/alerts/webhook'
        http_config:
          authorization:
            type: Bearer
            credentials_file: /etc/alertmanager/webhook.token
        send_resolved: true

  - name: 'all'
    email_configs:
      - to: '${ALERT_EMAIL_TO}'
        send_resolved: true
    webhook_configs:
      - url: 'http://api:3000/api/admin/alerts/webhook'
        http_config:
          authorization:
            type: Bearer
            credentials_file: /etc/alertmanager/webhook.token
        send_resolved: true

  - name: 'strafor-admin'
    webhook_configs:
      - url: 'http://api:3000/api/admin/alerts/webhook'
        http_config:
          authorization:
            type: Bearer
            credentials_file: /etc/alertmanager/webhook.token
        send_resolved: true

inhibit_rules:
  # If a container is down, suppress per-container alerts for the same container
  - source_matchers: ['alertname="ContainerDown"']
    target_matchers: ['alertname=~"ContainerHigh.*|ContainerOOMKilled|ContainerRestarting"']
    equal: ['container']
  # If a service target is down, suppress error rate / latency alerts
  - source_matchers: ['alertname="ServiceTargetDown"']
    target_matchers: ['alertname=~"ServiceHighErrorRate|ServiceHighLatencyP95"']
    equal: ['service']
