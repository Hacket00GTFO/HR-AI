# Registry resilience — applies to local installs and in-container builds
# (the Dockerfiles COPY this file before running pnpm). On flaky networks a
# failed RUN layer otherwise discards hundreds of already-fetched packages.
fetch-retries=6
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000
fetch-timeout=120000
# Fewer parallel sockets: saturated links fail harder under pnpm's default 16.
network-concurrency=8
