# ---- StraforAI root environment (docker compose reads .env from repo root) ----
# Copy to .env and fill in real values. NEVER commit a real .env.
# Per-app vars live in apps/<app>/.env.example.

# PostgreSQL container + monolith connection
POSTGRES_DB=innovation
POSTGRES_USER=strafor
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://strafor:CHANGE_ME@db:5432/innovation
# For running apps/api directly on the host against compose db:
# DATABASE_URL=postgres://strafor:CHANGE_ME@localhost:5432/innovation

# JWT (legacy monolith HS256 â€” identity-auth service moves to RS256+JWKS)
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=15m

# CORS allowlist (comma-separated). Dev default: http://localhost:3000
CORS_ORIGIN=

# Platform services
RABBITMQ_USER=strafor
RABBITMQ_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=strafor
MINIO_ROOT_PASSWORD=CHANGE_ME
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://strafor:CHANGE_ME@rabbitmq:5672
# Topic exchange the api outbox relay publishes domain events to.
RABBITMQ_EXCHANGE=domain.events
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_BUCKET=strafor-documents
MINIO_USE_SSL=false

# Notifications â€” Mailpit dev SMTP sink (no auth)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=StraforAI <no-reply@strafor.local>

# AI matching service (external LLM â€” REQUIRED for real matching; without a
# key the service runs in deterministic fallback mode)
LLM_PROVIDER=openai          # openai | anthropic | mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PARSE_MODEL=gpt-4o-mini
LLM_RERANK_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
LLM_MONTHLY_BUDGET_USD=50
AI_SERVICE_URL=http://ai-matching:3005

# Service base URLs (container-to-container, for gateway routing)
IDENTITY_URL=http://identity-auth:3001
IDENTITY_JWKS_URL=http://identity-auth:3001/.well-known/jwks.json
VACANCIES_URL=http://vacancies:3002
CANDIDATES_URL=http://candidates-applications:3003
DOCUMENTS_URL=http://documents-resumes:3004
ANALYTICS_URL=http://analytics:3008
NOTIFICATIONS_URL=http://notifications:3007
HR_CORE_URL=http://hr-core:3010
# Extracted services fronted by the gateway. Empty value → that path family
# falls back to the monolith (/api/v1/x → /api/x rewrite).
RECRUITMENT_CORE_URL=http://recruitment-core:3009
TIME_ATTENDANCE_URL=http://time-attendance:3011
PAYROLL_ADAPTER_URL=http://payroll-adapter:3012
HR_SERVICES_URL=http://hr-services:3014
CALENDAR_BRIDGE_URL=http://calendar-bridge:3016
API_URL=http://api:3000
GATEWAY_URL=http://gateway:8081
STATIC_FALLBACK_URL=http://web:3010
PUBLIC_BASE_URL=http://localhost:8081

# identity-auth: RS256 keypair â€” generate with:
#   pnpm --filter @strafor/identity-auth genkeys
# then paste the PEMs (\n-escaped) or mount apps/identity-auth/keys/.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=strafor-identity
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# AES-256-GCM key (base64, 32 bytes) encrypting integration credentials at rest.
SETTINGS_ENCRYPTION_KEY=
# Internal service-to-service auth token (required by ai-matching/notifications).
SERVICE_AUTH_TOKEN=CHANGE_ME
# Monolith accepts legacy HS256 tokens too (default false â€” JWKS only).
ALLOW_LEGACY_HS256=false

# web frontend: legacy = monolith /api/*, v1 = gateway /api/v1/*
AUTH_MODE=legacy

# Gateway proxy tuning
PROXY_TIMEOUT_MS=10000
UPLOAD_TIMEOUT_MS=30000
MINIO_PUBLIC_ENDPOINT=
AI_MIN_MATCH_SCORE=0.35

# calendar-bridge: Microsoft 365 / Entra ID app registration (client
# credentials, application permission Calendars.ReadWrite). Leave ALL THREE
# EMPTY to run the deterministic stub provider (no external calls).
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

PORT=3000

# ---- Observability stack (Prometheus + Grafana + Loki + Tempo + Alertmanager) ----
# Prometheus scrapes /metrics from every service + exporters (cAdvisor,
# node-exporter, postgres/redis/blackbox/celery exporters).
PROMETHEUS_URL=http://prometheus:9090
ALERTMANAGER_URL=http://alertmanager:9093
# Grafana is NEVER published on a host port in the base compose file.
# The Next.js BFF proxies it via /api/grafana/* with auth-proxy headers.
GRAFANA_INTERNAL_URL=http://grafana:3000
GRAFANA_PUBLIC_PATH=/api/grafana
LOKI_URL=http://loki:3100
TEMPO_URL=http://tempo:3200
# OpenTelemetry OTLP/HTTP endpoint (Tempo). Used by node-common/tracing.js
# and the Python ai-matching service.
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.2
# Bearer token required to scrape /metrics on every service. Generate a
# random string (e.g. `openssl rand -hex 32`) and set the same value here
# and in METRICS_TOKEN for each service fragment.
METRICS_TOKEN=CHANGE_ME
# Bearer token Alertmanager sends to the monolith webhook
# (POST /api/admin/alerts/webhook). Must match ALERT_WEBHOOK_TOKEN on the api.
ALERT_WEBHOOK_TOKEN=CHANGE_ME
# Alert email recipient + SMTP relay (Mailpit in dev, real SMTP in prod).
ALERT_EMAIL_TO=admin@strafor.local
ALERT_SMTP_HOST=mailpit
ALERT_SMTP_PORT=1025
ALERT_SMTP_FROM=StraforAI Alerts <alerts@strafor.local>
# Retention (production defaults). Lower these on modest hardware.
PROMETHEUS_RETENTION_TIME=90d
PROMETHEUS_RETENTION_SIZE=20GB
LOKI_RETENTION_PERIOD=720h
TEMPO_BLOCK_RETENTION=336h
# Grafana break-glass admin password (only used if you publish Grafana via
# the dev override docker-compose.observability-dev.yml).
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME
